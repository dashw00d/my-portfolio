---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
const pageTitle = `${title} | Ryan Stefan`;
---

<BaseLayout title={pageTitle} description={description} path={path} robots="index,follow">
  <main class="min-h-screen bg-gradient-to-b from-white via-brand-50/30 to-white px-6 pb-24 pt-32 text-zinc-900">
    <div class="mx-auto max-w-4xl">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700 transition hover:text-brand-900"
      >
        <span aria-hidden>←</span>
        Back to dashwood.net
      </a>

      <div class="mt-8 overflow-hidden rounded-3xl border border-zinc-200 bg-white shadow-xl shadow-brand-950/5">
        <header class="border-b border-brand-100 bg-gradient-to-br from-brand-950 via-brand-900 to-accent-900 px-6 py-10 text-white sm:px-10">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-brand-200">
            Dashwood policies
          </p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
            {title}
          </h1>
          <p class="mt-4 text-sm text-brand-100">
            Effective August 6, 2026 · Last updated August 6, 2026
          </p>
        </header>

        <article class="prose prose-zinc max-w-none px-6 py-10 prose-headings:scroll-mt-24 prose-headings:text-zinc-900 prose-a:text-brand-700 prose-a:decoration-brand-300 prose-a:underline-offset-4 hover:prose-a:text-brand-900 sm:px-10">
          <slot />
        </article>
      </div>
    </div>
  </main>
</BaseLayout>
