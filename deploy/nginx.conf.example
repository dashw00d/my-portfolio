# Point the vhost document root at this repo's `dist/` directory.
# PHP-FPM is only needed for POST /api/contact.php. Keep it ondemand so
# idle RAM stays with nginx, not a Node process.

server {
    listen 80;
    listen 443 ssl http2;
    server_name dashwood.net www.dashwood.net;
    root /home/USER/webapps/dashwood/dist;
    index index.html;

    location / {
        try_files $uri $uri/ $uri.html /404.html;
    }

    # POST to a static .php file returns 405. This location must run PHP-FPM.

    location = /404.html {
        internal;
    }

    location ~* ^/_astro/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location ~* \.(css|js|mjs|woff2?|png|jpe?g|gif|webp|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location ~ /\.env {
        deny all;
    }

    location = /api/contact.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/api/contact.php;
        fastcgi_param SMTP_HOST $SMTP_HOST;
        fastcgi_param SMTP_PORT $SMTP_PORT;
        fastcgi_param SMTP_USER $SMTP_USER;
        fastcgi_param SMTP_PASS $SMTP_PASS;
        fastcgi_param CONTACT_TO $CONTACT_TO;
        fastcgi_param CONTACT_FROM $CONTACT_FROM;
        fastcgi_param CONTACT_BCC $CONTACT_BCC;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location = /api/contact.php/ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/api/contact.php;
        fastcgi_param SMTP_HOST $SMTP_HOST;
        fastcgi_param SMTP_PORT $SMTP_PORT;
        fastcgi_param SMTP_USER $SMTP_USER;
        fastcgi_param SMTP_PASS $SMTP_PASS;
        fastcgi_param CONTACT_TO $CONTACT_TO;
        fastcgi_param CONTACT_FROM $CONTACT_FROM;
        fastcgi_param CONTACT_BCC $CONTACT_BCC;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location ~ \.php$ {
        deny all;
    }
}
