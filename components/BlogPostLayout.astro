---
import { tagToSlug } from "@/lib/blog-utils";

interface Props {
  title: string;
  date: string;
  tags?: string[];
  readingTime?: number;
}

const { title, date, tags = [], readingTime } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="mx-auto max-w-3xl px-6 py-12">
  <a
    href="/blog/"
    class="mb-8 inline-flex items-center gap-2 text-sm font-medium text-brand-600 transition-colors hover:text-brand-700"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m12 19-7-7 7-7"></path>
      <path d="M19 12H5"></path>
    </svg>
    Back to Blog
  </a>

  <header class="mb-10 space-y-3">
    <div class="flex items-center gap-3 text-sm text-zinc-500">
      <time datetime={date}>{formattedDate}</time>
      {readingTime && (
        <>
          <span class="text-zinc-300">•</span>
          <span>{readingTime} min read</span>
        </>
      )}
    </div>

    <h1 class="text-3xl font-bold leading-tight tracking-tight text-zinc-900 md:text-4xl md:leading-tight">
      {title}
    </h1>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 pt-2">
        {tags.map((tag) => (
          <a
            href={`/blog/tag/${tagToSlug(tag)}/`}
            class="rounded-full bg-brand-500/10 px-3 py-1 text-xs font-medium text-brand-600 transition hover:bg-brand-100"
          >
            {tag}
          </a>
        ))}
      </div>
    )}
  </header>

  <div
    class="prose prose-zinc max-w-none
      prose-p:!mb-4 prose-p:!leading-[1.7]
      prose-headings:!font-semibold prose-headings:!tracking-tight prose-headings:!text-zinc-900
      prose-h1:!mb-4 prose-h1:!mt-10 prose-h1:!text-3xl
      prose-h2:!mb-3 prose-h2:!mt-8 prose-h2:!text-2xl
      prose-h3:!mb-2 prose-h3:!mt-6 prose-h3:!text-xl
      prose-h4:!mb-2 prose-h4:!mt-5 prose-h4:!text-lg
      prose-ul:!my-4 prose-ul:!space-y-1
      prose-ol:!my-4 prose-ol:!space-y-1
      prose-li:!my-1 prose-li:!leading-[1.7]
      prose-a:!font-medium prose-a:!text-brand-600 prose-a:!no-underline hover:prose-a:!underline
      prose-code:!rounded prose-code:!bg-brand-50 prose-code:!px-1.5 prose-code:!py-0.5 prose-code:!font-mono prose-code:!text-[0.9em] prose-code:!font-normal prose-code:!text-brand-700 prose-code:!before:content-[''] prose-code:!after:content-['']
      prose-pre:!my-5 prose-pre:!overflow-x-auto prose-pre:!rounded-lg prose-pre:!border-0 prose-pre:!bg-zinc-900 prose-pre:!p-4 prose-pre:!text-sm prose-pre:!leading-[1.6] prose-pre:!text-zinc-100
      prose-blockquote:!my-5 prose-blockquote:!border-l-4 prose-blockquote:!border-brand-500 prose-blockquote:!pl-4 prose-blockquote:!italic prose-blockquote:!text-zinc-600
      prose-img:!my-6 prose-img:!rounded-lg prose-img:!shadow-md
      prose-hr:!my-8 prose-hr:!border-zinc-200
      prose-strong:!font-semibold prose-strong:!text-zinc-900
      [&>:first-child]:!mt-0
      [&_pre_code]:!rounded-none [&_pre_code]:!bg-transparent [&_pre_code]:!p-0 [&_pre_code]:!text-sm [&_pre_code]:!text-zinc-100"
  >
    <slot />
  </div>
</article>
