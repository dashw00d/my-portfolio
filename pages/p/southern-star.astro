---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProposalPage from "../../components/pages/ProposalPage";
import ProposalPreload from "../../components/proposal/ProposalPreload.astro";
import { PROPOSAL_CONFIG } from "../../lib/proposal/config";
---

<BaseLayout
  title="Southern Star website proposal"
  description="A private proposal for the Southern Star website rebuild."
  path="/p/southern-star"
  robots="noindex,nofollow,noarchive"
  privatePage
  showNav={false}
  showFooter={false}
>
  <ProposalPreload slot="head" />
  <ProposalPage initialConfig={PROPOSAL_CONFIG} client:load />
</BaseLayout>
