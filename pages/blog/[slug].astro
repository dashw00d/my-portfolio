---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPostLayout from "../../components/BlogPostLayout.astro";
import { getAllPosts, getPostBySlug } from "../../lib/blog";
import { SITE_NAME, SITE_URL } from "../../lib/site";

export async function getStaticPaths() {
  const posts = getAllPosts();
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      slug: post.slug,
      nextPost:
        index > 0
          ? { slug: posts[index - 1].slug, title: posts[index - 1].title }
          : null,
      previousPost:
        index < posts.length - 1
          ? { slug: posts[index + 1].slug, title: posts[index + 1].title }
          : null,
    },
  }));
}

interface AdjacentPost {
  slug: string;
  title: string;
}

interface Props {
  slug: string;
  nextPost: AdjacentPost | null;
  previousPost: AdjacentPost | null;
}

const { slug, nextPost, previousPost } = Astro.props as Props;
const post = getPostBySlug(slug);

if (!post) {
  return Astro.redirect("/404/");
}

const modules = import.meta.glob<{ default: unknown }>("../../content/blog/*.mdx");
const modulePath = Object.keys(modules).find((path) => path.endsWith(`/${slug}.mdx`));

let Content: unknown = null;
if (modulePath) {
  try {
    const loaded = await modules[modulePath]();
    Content = loaded.default;
  } catch (error) {
    console.warn(`[blog] Skipping malformed post: ${slug}`, error);
  }
}

if (!Content) {
  return Astro.redirect("/404/");
}

const postUrl = `${SITE_URL}/blog/${post.slug}`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: post.excerpt,
    datePublished: post.date,
    dateModified: post.date,
    wordCount: post.content.trim().split(/\s+/).length,
    keywords: post.tags.join(", "),
    articleSection: post.tags[0] || "Engineering",
    author: {
      "@type": "Person",
      name: post.author,
      url: SITE_URL,
    },
    publisher: {
      "@type": "Person",
      name: "Ryan Stefan",
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": postUrl,
    },
    url: postUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Blog",
        item: `${SITE_URL}/blog`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: post.title,
        item: postUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={`${post.title} | ${SITE_NAME}`}
  description={post.excerpt}
  path={`/blog/${post.slug}`}
  type="article"
  keywords={post.tags.join(", ")}
  author={post.author}
  publishedTime={post.date}
  articleTags={post.tags}
  prevUrl={previousPost ? `${SITE_URL}/blog/${previousPost.slug}` : null}
  nextUrl={nextPost ? `${SITE_URL}/blog/${nextPost.slug}` : null}
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-gradient-to-b from-white via-brand-50/20 to-white py-20 text-zinc-900">
    <BlogPostLayout title={post.title} date={post.date} tags={post.tags} readingTime={post.readingTime}>
      <Content />
    </BlogPostLayout>

    {(previousPost || nextPost) && (
      <section class="mx-auto mt-10 grid max-w-3xl gap-4 px-6 md:grid-cols-2">
        <div>
          {nextPost ? (
            <a
              href={`/blog/${nextPost.slug}/`}
              class="block rounded-xl border border-zinc-200 bg-white/80 p-4 transition hover:border-brand-300 hover:shadow-sm"
            >
              <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Newer post</p>
              <p class="mt-1 text-sm font-semibold text-zinc-900">{nextPost.title}</p>
            </a>
          ) : null}
        </div>
        <div>
          {previousPost ? (
            <a
              href={`/blog/${previousPost.slug}/`}
              class="block rounded-xl border border-zinc-200 bg-white/80 p-4 text-right transition hover:border-brand-300 hover:shadow-sm"
            >
              <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Older post</p>
              <p class="mt-1 text-sm font-semibold text-zinc-900">{previousPost.title}</p>
            </a>
          ) : null}
        </div>
      </section>
    )}
  </main>
</BaseLayout>
