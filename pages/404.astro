---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Ryan Stefan"
  description="The page you requested does not exist."
  path="/404"
  robots="noindex,follow"
>
  <main class="flex min-h-screen flex-col items-center justify-center bg-gradient-to-b from-white via-brand-50/30 to-white px-6 text-center text-zinc-900">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-brand-600">404</p>
    <h1 class="mt-4 text-4xl font-black tracking-tight">Page not found</h1>
    <p class="mt-3 max-w-md text-zinc-600">
      That URL is not on dashwood.net. Head home or browse the blog.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/" class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white">Home</a>
      <a href="/blog/" class="rounded-xl border border-zinc-300 bg-white px-5 py-2.5 text-sm font-semibold text-zinc-700">Blog</a>
    </div>
  </main>
</BaseLayout>
