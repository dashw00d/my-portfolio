---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contact from "../components/Contact";
import Examples from "../components/Examples";
import Hero from "../components/Hero";
import Problems from "../components/Problems";
import Process from "../components/Process";
import Services from "../components/Services";
import { SITE_URL } from "../lib/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Dashwood - Ryan Stefan",
  description:
    "Websites, custom apps, and workflow automation that help small businesses save time and serve their customers.",
  url: SITE_URL,
  telephone: "(737) 205-9226",
  email: "ryan@dashwood.net",
  founder: {
    "@type": "Person",
    name: "Ryan Stefan",
    jobTitle: "Web Developer & Automation Specialist",
    email: "ryan@dashwood.net",
  },
  areaServed: "Worldwide",
  serviceType: [
    "Small Business Web Development",
    "Custom Web Applications",
    "Workflow Automation & AI",
    "Website Performance & Hosting",
    "CRM & Email Integrations",
  ],
};
---

<BaseLayout
  title="Websites, Apps & Automation for Small Businesses | Ryan Stefan"
  description="I build websites, custom apps, and practical automations for small businesses. Fix slow pages, connect your tools, and cut manual work. Work directly with Ryan Stefan."
  path="/"
  keywords="small business web developer, custom apps, workflow automation, Laravel 13, Astro, React, TypeScript, Ryan Stefan, dashwood"
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-gradient-to-br from-zinc-50 via-brand-50/20 to-white text-zinc-900">
    <Hero client:idle />
    <Problems client:visible />
    <Services />
    <Process />
    <Examples />
    <Contact client:load />
  </main>
</BaseLayout>
